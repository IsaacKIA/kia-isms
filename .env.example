# Environment Configuration for KIA-ISMS (Local Development & Testing)

# Optional: Supabase PostgreSQL Connection String
# When unset, KIA-ISMS automatically persists to embedded PostgreSQL 16 (PGlite) under ./data/pgdata
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Local Embedded Database Directory
PGLITE_DATA_DIR="./data/pgdata"

# Application Port
PORT=3000
